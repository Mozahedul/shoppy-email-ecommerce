<mjml>
  <mj-head>
    <!-- Email Subject Preview -->
    <mj-preview>
      Limited-time offer on handcrafted ceramic mugs. Shop now before it's gone.
    </mj-preview>

    <!-- Breakpoint -->
    <mj-breakpoint width="380px" />

    <!-- Email Title -->
    <mj-title>Obsidian Ceramic Mug – Special Offer</mj-title>

    <!-- Google Font -->
    <mj-font
      name="Lora"
      href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&display=swap"
    />

    <!--
    ================================================
      COLOR SYSTEM
    ================================================

      LIGHT MODE
      ----------
      Email outer bg        → #f4f4f4
      Section bg            → #ffffff
      Card bg               → #f8f8f8
      Border                → #e8e8e8
      Heading               → #111111
      Subheading            → #444444
      Body text             → #666666
      Muted                 → #888888
      Footer text           → #999999

      DARK MODE
      ----------
      Email outer bg        → #111111
      Section bg            → #1a1a1a
      Card bg               → #222222
      Border                → #333333
      Heading               → #f0f0f0
      Subheading            → #cccccc
      Body text             → #aaaaaa
      Muted                 → #888888
      Footer text           → #666666

      ACCENT (both modes)
      -------------------
      Primary green         → #1a5c38
      Amber                 → #c97d2e

      DIVIDERS
      --------
      Light                 → #e8e8e8  (dark: #333333)
      Strong                → #cccccc  (dark: #444444)
    ================================================
    -->
    <!-- Global Attributes -->
    <mj-attributes>
      <!-- Entire Email -->
      <mj-all
        font-family="'Lora', Georgia, 'Times New Roman', Arial, serif"
        color="#444444"
        line-height="1.5"
      />

      <!-- Body -->
      <mj-body background-color="#f4f4f4" />

      <!-- Sections -->
      <mj-section padding="0" background-color="#ffffff" />

      <!-- Columns -->
      <mj-column padding="0" />

      <!-- Text -->
      <mj-text
        padding="0"
        font-size="16px"
        line-height="24px"
        color="#444444"
      />

      <!-- Buttons — primary default -->
      <mj-button
        border-radius="4px"
        font-size="14px"
        font-weight="600"
        inner-padding="14px 28px"
        padding="0"
        background-color="#111111"
        color="#ffffff"
      />

      <!-- Images -->
      <mj-image padding="0" border="0" fluid-on-mobile="true" />

      <!-- Divider -->
      <mj-divider
        border-style="solid"
        border-color="#e8e8e8"
        border-width="1px"
        width="100%"
        align="left"
        padding="15px 0"
      />
    </mj-attributes>

    <!-- STYLE BLOCK 1: Inlined regular styles -->
    <mj-style inline="inline">
      a {
        text-decoration: none;
      }
      img {
        display: block;
        border: 0;
        outline: none;
        text-decoration: none;
      }
      p {
        margin: 0;
        padding: 0;
      }
    </mj-style>

    <!--
      STYLE BLOCK 2: Dark mode — NOT inlined
      ----------------------------------------
      MJML compiles to nested tables. Background sits on
      multiple levels: div > table > tbody > tr > td.
      We must target ALL levels with !important to override
      the hardcoded inline background-color attributes.

      Same for text: MJML puts color as inline style on the
      wrapping div. We target div, p, span, a with !important.

      CSS CLASSES USED:
      dm-bg-outer    → outer email body
      dm-bg-section  → white sections (#ffffff → #1a1a1a)
      dm-bg-card     → card sections (#f8f8f8 → #222222)
      dm-text-h      → headings
      dm-text-sub    → subheadings / feature list
      dm-text-body   → body / description text
      dm-text-muted  → muted / subtitle text
      dm-text-footer → footer text
      dm-text-nav    → navbar links
      dm-text-link   → inline links
      dm-btn-primary → primary button (inverts)
      dm-div-light   → light divider
      dm-div-strong  → strong divider
      dm-table-row   → table data rows
    -->

    <mj-style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      @media (prefers-color-scheme: dark) {
        /* ── Outer email background ── */
        body,
        .dm-bg-outer,
        .dm-bg-outer > div,
        .dm-bg-outer > table,
        .dm-bg-outer > table > tbody > tr > td {
          background-color: #111111 !important;
        }

        /* ── White section backgrounds ── */
        .dm-bg-section,
        .dm-bg-section > div,
        .dm-bg-section > table,
        .dm-bg-section > table > tbody > tr > td,
        .dm-bg-section td {
          background-color: #1a1a1a !important;
        }

        .dm-bg-section-soft,
        .dm-bg-section-soft > div,
        .dm-bg-section-soft > table,
        .dm-bg-section-soft > table > tbody > tr > td,
        .dm-bg-section-soft td {
          background-color: #141414 !important;
        }

        /* ── Card / gray section backgrounds ── */
        .dm-bg-card,
        .dm-bg-card > div,
        .dm-bg-card > table,
        .dm-bg-card > table > tbody > tr > td,
        .dm-bg-card td {
          background-color: #222222 !important;
          border-color: #333333 !important;
        }

        /* ── Headings ── */
        .dm-text-h,
        .dm-text-h div,
        .dm-text-h p,
        .dm-text-h span,
        .dm-text-h a {
          color: #f0f0f0 !important;
        }

        /* ── Subheadings / feature list ── */
        .dm-text-sub,
        .dm-text-sub div,
        .dm-text-sub p,
        .dm-text-sub span,
        .dm-text-sub a {
          color: #cccccc !important;
        }

        /* ── Body / description text ── */
        .dm-text-body,
        .dm-text-body div,
        .dm-text-body p,
        .dm-text-body span,
        .dm-text-body a {
          color: #aaaaaa !important;
        }

        /* ── Muted / subtitle text ── */
        .dm-text-muted,
        .dm-text-muted div,
        .dm-text-muted p,
        .dm-text-muted span,
        .dm-text-muted a {
          color: #888888 !important;
        }

        /* ── Footer text ── */
        .dm-text-footer,
        .dm-text-footer div,
        .dm-text-footer p,
        .dm-text-footer span,
        .dm-text-footer a {
          color: #666666 !important;
        }

        /* ── Navbar links ── */
        .dm-text-nav,
        .dm-text-nav div,
        .dm-text-nav div a,
        .dm-text-nav a {
          color: #aaaaaa !important;
        }

        /* ── Inline links ── */
        .dm-text-link,
        .dm-text-link div,
        .dm-text-link div a,
        .dm-text-link a {
          color: #f0f0f0 !important;
        }

        /* ── Primary button: invert to light in dark mode ── */
        .dm-btn-primary table,
        .dm-btn-primary table td,
        .dm-btn-primary table td a {
          background-color: #f0f0f0 !important;
          color: #111111 !important;
        }

        /* ── Light divider ── */
        .dm-div-light p,
        .dm-div-light div,
        .dm-div-light td {
          border-color: #333333 !important;
        }

        /* ── Strong divider ── */
        .dm-div-strong p,
        .dm-div-strong div,
        .dm-div-strong td {
          border-color: #444444 !important;
        }

        /* ── Table data rows ── */
        .dm-table-row td {
          color: #aaaaaa !important;
          border-color: #333333 !important;
        }
      }
    </mj-style>

    <!-- Raw meta tags -->
    <mj-raw>
      <meta charset="UTF-8" /> <meta http-equiv="X-UA-Compatible"
      content="IE=edge" /> <meta name="viewport" content="width=device-width,
      initial-scale=1.0" /> <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" /> <meta
      name="format-detection" content="telephone=no, date=no, address=no,
      email=no, url=no" /> <meta name="x-apple-disable-message-reformatting" />
      <meta http-equiv="List-Unsubscribe"
      content="<mailto:unsubscribe@example.com?subject=unsubscribe>,
      <https://example.com/unsubscribe>" />
    </mj-raw>
  </mj-head>

  <mj-body width="600px" background-color="#f4f4f4" css-class="dm-bg-outer">
    <!-- ============================================================ -->
    <!-- LOGO                                                          -->
    <!-- ============================================================ -->
    <mj-section background-color="#fef4f2">
      <mj-column vertical-align="top">
        <mj-image
          align="center"
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778602575/shoppy-email-ecommerce/images/shoppy-logo_i1urkp.png"
          alt="Ultimate Technology Limited"
          href="https://taqwaitagency.com"
          padding="16px 0"
          width="140px"
        />
      </mj-column>
    </mj-section>
    <!-- ============================================================ -->
    <!-- HERO — dark bg image, no dark mode override needed            -->
    <!-- ============================================================ -->
    <mj-hero
      mode="fluid-height"
      background-url="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778604053/shoppy-email-ecommerce/images/banner_fpnepv.png"
      background-color="#fef5f2"
      background-width="600px"
      background-height="300px"
    >
      <mj-text
        color="#444444"
        align="center"
        line-height="1.2"
        padding="10px 0"
      >
        <span style="font-size: 32px; font-weight: 700">
          Looks like you <br />
          left something<br />
          behind
        </span>
      </mj-text>

      <mj-text
        align="center"
        padding="0px 0px 10px 0px"
        font-size="16px"
        font-weight="600"
      >
        We saved your cart for you
      </mj-text>

      <mj-spacer height="15px" />
      <!-- Hero button — amber accent -->
      <mj-button
        href="https://mjml.io/product"
        font-size="14px"
        line-height="1"
        align="center"
        background-color="#f14e5d"
        color="#ffffff"
      >
        Order Your Ticket Now
      </mj-button>
    </mj-hero>

    <!--
    mj spacer
    For creating horizontal space between sections
    -->
    <mj-section>
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>

    <!-- ============================================================ -->
    <!-- 2 COLUMN ARTICLE SECTION                                      -->
    <!-- ============================================================ -->
    <mj-section
      padding="8px 0"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-column padding="0px 10px">
        <mj-image
          fluid-on-mobile="true"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778601459/shoppy-email-ecommerce/images/1_zbkwlu.png"
          alt="Beautiful white flower in natural light"
          padding="0"
          width="120px"
          align="right"
        />
      </mj-column>

      <mj-column padding="0 10px">
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="16px"
          font-weight="bold"
          color="#111111"
          padding="10px 0"
        >
          Oversized Cotton T-Shirt
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="13px"
          font-weight="bold"
          line-height="1.4"
          color="#666666"
        >
          $29.99
        </mj-text>
        <mj-text font-size="13px" color="#777777" padding="6px 0 0">
          Size: L | Color: White
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============================================================ -->
    <!-- 2 COLUMN ARTICLE SECTION                                      -->
    <!-- ============================================================ -->
    <mj-section
      padding="8px 0px"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-column padding="0px 10px">
        <mj-image
          fluid-on-mobile="true"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778601459/shoppy-email-ecommerce/images/2_o6t9po.png"
          alt="Minimal leather watch"
          padding="0"
          width="120px"
          align="right"
        />
      </mj-column>

      <mj-column padding="0 10px">
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="16px"
          font-weight="bold"
          color="#111111"
          padding="10px 0"
        >
          Minimal Leather Watch
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="13px"
          font-weight="bold"
          line-height="1.4"
          color="#666666"
        >
          $89.99
        </mj-text>
        <mj-text font-size="13px" color="#777777" padding="6px 0 0">
          Size: L | Color: Brown
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============================================================ -->
    <!-- 2 COLUMN ARTICLE SECTION                                      -->
    <!-- ============================================================ -->
    <mj-section
      padding="8px 0"
      background-color="#ffffff"
      css-class="dm-bg-section"
    >
      <mj-column padding="0px 10px">
        <mj-image
          fluid-on-mobile="true"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778601459/shoppy-email-ecommerce/images/1_zbkwlu.png"
          alt="Beautiful white flower in natural light"
          padding="0"
          width="120px"
          align="right"
        />
      </mj-column>

      <mj-column padding="0 10px">
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="16px"
          font-weight="bold"
          color="#111111"
          padding="10px 0"
        >
          Oversized Cotton T-Shirt
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="13px"
          font-weight="bold"
          line-height="1.4"
          color="#666666"
        >
          $29.99
        </mj-text>
        <mj-text font-size="13px" color="#777777" padding="6px 0 0">
          Size: L | Color: White
        </mj-text>
      </mj-column>
    </mj-section>

    <!--
   mj spacer
   For creating horizontal space between sections
   -->
    <mj-section css-class="dm-bg-section">
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>

    <!-- 3 COLUMN ICONS SECTION -->
    <mj-section
      padding="30px 0px"
      background-color="#fdeded"
      css-class="dm-bg-section-soft"
    >
      <mj-column padding="0 10px 20px">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778584464/email-portfolio/luxeora/icons/truck_obd6bo.png"
          alt="Shopping for women"
          width="50px"
          padding="0px"
        />
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="13px"
          font-weight="bold"
          color="#111111"
          padding="10px 0 5px"
          align="center"
          text-transform="uppercase"
        >
          Free shipping
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="12px"
          line-height="1.4"
          color="#666666"
          align="center"
        >
          <span
            href="https://mjml.io/women"
            style="color: #444444; text-decoration: none; font-weight: 500"
            >On orders over $75</span
          >
        </mj-text>
      </mj-column>

      <mj-column padding="0px 10px 20px">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778601458/shoppy-email-ecommerce/icons/clock_jjokoo.png"
          alt="Shopping for men"
          width="40px"
          padding="0"
        />
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="13px"
          font-weight="bold"
          color="#111111"
          padding="10px 0 5px"
          align="center"
          text-transform="uppercase"
        >
          Easy Returns
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="12px"
          line-height="1.4"
          color="#666666"
          align="center"
        >
          <span
            href="https://mjml.io/women"
            style="color: #444444; text-decoration: none; font-weight: 500"
            >30 days return</span
          >
        </mj-text>
      </mj-column>
      <mj-column padding="0 10px">
        <mj-image
          fluid-on-mobile="false"
          src="https://res.cloudinary.com/ducp0w6mx/image/upload/v1778601459/shoppy-email-ecommerce/icons/headphone_qyvlir.png"
          alt="Shopping for men"
          width="40px"
          padding="0"
        />
        <!-- article heading: #111111 -->
        <mj-text
          css-class="dm-text-h"
          font-size="13px"
          font-weight="bold"
          color="#111111"
          padding="10px 0 5px"
          align="center"
          text-transform="uppercase"
          line-height="1.4"
        >
          Secure Payment
        </mj-text>
        <!-- article body: #666666 -->
        <mj-text
          css-class="dm-text-body"
          font-size="12px"
          line-height="1.4"
          color="#666666"
          align="center"
        >
          <span
            href="https://mjml.io/women"
            style="color: #444444; text-decoration: none; font-weight: 500"
            >100% Safe</span
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
